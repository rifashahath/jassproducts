# ==============================================================================
# JASS PRODUCTS ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Configuration (Client-side; VITE_ prefix is bundled into frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (SERVER-ONLY -- never expose to browser)
# Used by backend handlers in api/ to securely verify payments & manage orders
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Razorpay Payment Gateway
# VITE_RAZORPAY_KEY_ID is public, used by the client-side checkout widget
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here
# RAZORPAY_KEY_SECRET is private, used server-side to sign and verify payments
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Serverless / Edge Function Base URL
# Unset defaults to "/api" (for Vercel or local proxy).
# Set to "https://your-project.supabase.co/functions/v1" if deploying to Supabase Edge Functions.
VITE_API_BASE_URL=

# Allowed origins for CORS (e.g. your production domain + local development)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional Gemini API Key
GEMINI_API_KEY=
